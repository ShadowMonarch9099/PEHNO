# Where the PEHNO API lives (server-side only)
API_URL=http://localhost:8000
# Must match ADMIN_API_KEY in apps/api/.env — never exposed to the browser
ADMIN_API_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Only Google accounts on this domain may sign in
ADMIN_EMAIL_DOMAIN=pehno.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev-only fallback when Google isn't configured: a shared password (disabled in production)
ADMIN_DEV_PASSWORD=
