{
  "expo": {
    "name": "Pehno",
    "slug": "pehno",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pehno",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#fff8f1" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": false, "bundleIdentifier": "in.pehno.app" },
    "android": {
      "package": "in.pehno.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#fff8f1" }
    },
    "plugins": ["expo-secure-store"]
  }
}
