{
  "expo": {
    "name": "Pehno",
    "slug": "pehno",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pehno",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.pehno.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pehno needs camera access to photograph your garments.",
        "NSPhotoLibraryUsageDescription": "Pehno needs photo library access to add garments to your wardrobe."
      }
    },
    "android": {
      "package": "in.pehno.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff8f1"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pehno needs photo library access to add garments to your wardrobe.",
          "cameraPermission": "Pehno needs camera access to photograph your garments."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#964900"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
