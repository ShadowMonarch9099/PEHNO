# ── App ────────────────────────────────────────────────────────
APP_ENV=development            # development | test | production
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# ── Database ───────────────────────────────────────────────────
# Local dev (default): SQLite file next to the API.
DATABASE_URL=sqlite+aiosqlite:///./pehno.db
# Supabase / Postgres (when available):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.<project>.supabase.co:5432/postgres

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP ────────────────────────────────────────────────────────
# console (default in dev — OTP is logged and returned in the response) | msg91 | twilio
OTP_PROVIDER=console
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Storage ────────────────────────────────────────────────────
# local (default) | supabase
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./media
PUBLIC_BASE_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GARMENT_IMAGES_BUCKET=garment-images

# ── Garment AI ─────────────────────────────────────────────────
# rules | zero_shot (default; downloads ~600MB CLIP on first classify) | vit (fine-tuned)
# `pip install -r requirements-ml.txt` for zero_shot / vit.
CLASSIFIER_BACKEND=zero_shot
HF_CLIP_MODEL=patrickjohncyh/fashion-clip
CLASSIFIER_MIN_CONFIDENCE=0.30

# ── Background jobs ────────────────────────────────────────────
# Empty = run jobs in-process. Set both to use Celery workers (docker compose provides redis).
CELERY_BROKER_URL=
REDIS_URL=

# ── Weather ────────────────────────────────────────────────────
# Empty = monthly climatology for the user's city. Get a free key at openweathermap.org.
OPENWEATHER_API_KEY=

# ── Push notifications ─────────────────────────────────────────
# Empty = console notifier. Firebase service-account JSON (inline or a file path) enables FCM.
FIREBASE_SERVICE_ACCOUNT=
DAILY_PUSH_HOUR_IST=7
DAILY_PUSH_MINUTE_IST=30

# ── Observability ──────────────────────────────────────────────
SENTRY_DSN=
