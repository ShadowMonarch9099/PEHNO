# Celery worker — same image as the API (spec: infra/Dockerfile.worker).
#   docker build -f infra/Dockerfile.worker -t pehno-worker .
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/apps/api
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY packages/ai/data /app/packages/ai/data
COPY apps/api .
CMD ["celery", "-A", "app.tasks", "worker", "--loglevel=info", "--concurrency=2"]
