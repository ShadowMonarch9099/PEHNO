{
  "name": "pehno",
  "version": "1.0.0",
  "private": true,
  "description": "PEHNO â€” AI Wardrobe Intelligence Platform for India",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @pehno/mobile run start",
    "api": "cd apps/api && uvicorn main:app --reload --port 8000",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "typecheck": "tsc --noEmit -p apps/mobile && npm --workspace @pehno/admin run typecheck",
    "test:api": "cd apps/api && pytest -q",
    "admin": "npm --workspace @pehno/admin run dev"
  },
  "devDependencies": {
    "@pehno/config": "*",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
