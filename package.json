{
  "name": "pehno",
  "version": "1.0.0",
  "private": true,
  "description": "PEHNO — AI Wardrobe Intelligence Platform for India",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./dev.sh",
    "mobile": "yarn workspace @pehno/mobile start",
    "frontend": "yarn workspace @pehno/frontend dev",
    "frontend:build": "yarn workspace @pehno/frontend build",
    "api": "cd apps/api && uvicorn main:app --reload --port 8000",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "yarn workspaces run lint",
    "test": "yarn workspaces run test"
  },
  "devDependencies": {
    "@pehno/config": "*",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
